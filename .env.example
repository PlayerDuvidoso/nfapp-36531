# Supabase Configuration (PUBLIC - safe for browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here
VITE_SUPABASE_PROJECT_ID=your-project-id

# Application Environment
VITE_APP_ENV=production
VITE_APP_VERSION=1.0.0

# Optional: Error Tracking (Sentry)
# VITE_SENTRY_DSN=

# Optional: Analytics (Plausible)
# VITE_PLAUSIBLE_DOMAIN=

# ⚠️ SECURITY WARNING ⚠️
# NEVER commit the actual .env file with real values
# NEVER add SUPABASE_SERVICE_ROLE_KEY or other private keys here
# These values are PUBLIC and will be exposed in the browser bundle
